# Store text files with LF line endings in the repo. On Windows, Git may
# check them out with CRLF, which is fine for everything except shell scripts.
* text=auto

# Shell scripts must keep LF, or bash fails with "$'\r': command not found"
# (e.g. the Claude Code cloud SessionStart hook).
*.sh text eol=lf

# Binary files: never touch.
*.png binary
*.ico binary
*.icns binary
*.webp binary
*.jpg binary
